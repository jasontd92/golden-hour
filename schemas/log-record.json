{
	"$id": "golden-hour/log-record.json",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"id": {
			"type": "string",
			"format": "uuid",
			"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
		},
		"sessionDate": {
			"type": "string",
			"format": "date",
			"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
		},
		"blockIndex": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		},
		"prescriptionIndex": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		},
		"setIndex": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		},
		"movement": {
			"type": "string",
			"enum": [
				"thruster",
				"wall_ball",
				"overhead_squat",
				"front_squat",
				"back_squat",
				"air_squat",
				"pistol",
				"squat_snatch",
				"db_snatch",
				"power_snatch",
				"squat_clean",
				"power_clean",
				"clean_and_jerk",
				"jerk",
				"push_press",
				"shoulder_press",
				"bench_press",
				"deadlift",
				"sdhp",
				"kb_swing",
				"devils_press",
				"turkish_getup",
				"bear_complex",
				"lunge",
				"box_jump",
				"burpee",
				"pull_up",
				"chest_to_bar",
				"muscle_up",
				"ring_row",
				"weighted_row",
				"rope_climb",
				"hspu",
				"push_up",
				"dip",
				"handstand_walk",
				"toes_to_bar",
				"knees_to_elbow",
				"sit_up",
				"l_sit",
				"plank",
				"v_up",
				"double_under",
				"run",
				"row",
				"bike",
				"ski",
				"farmers_carry",
				"sled",
				"sandbag"
			]
		},
		"load": {
			"type": "number",
			"exclusiveMinimum": 0
		},
		"reps": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		},
		"rpe": {
			"type": "number",
			"minimum": 1,
			"maximum": 10,
			"multipleOf": 0.5
		},
		"note": {
			"type": "string",
			"minLength": 1,
			"maxLength": 500
		},
		"loggedAt": {
			"type": "string",
			"format": "date-time",
			"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
		},
		"deviceId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 64
		},
		"revision": {
			"type": "integer",
			"exclusiveMinimum": 0,
			"maximum": 9007199254740991
		},
		"deletedAt": {
			"type": "string",
			"format": "date-time",
			"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
		}
	},
	"required": [
		"id",
		"sessionDate",
		"blockIndex",
		"prescriptionIndex",
		"setIndex",
		"movement",
		"reps",
		"loggedAt",
		"deviceId",
		"revision"
	],
	"additionalProperties": false
}
