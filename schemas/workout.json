{
	"$id": "golden-hour/workout.json",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"id": {
			"type": "string",
			"pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
		},
		"name": {
			"type": "string",
			"minLength": 1
		},
		"aliases": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			}
		},
		"kind": {
			"type": "string",
			"enum": [
				"girl",
				"hero",
				"notable",
				"competition",
				"test",
				"personal",
				"class_wod",
				"strength"
			]
		},
		"description": {
			"type": [
				"string",
				"null"
			]
		},
		"descriptions": {
			"type": "array",
			"items": {
				"type": "string"
			}
		},
		"format": {
			"type": "string",
			"enum": [
				"for_time",
				"amrap",
				"emom",
				"intervals",
				"max_load",
				"max_reps",
				"max_hold",
				"composite",
				"other"
			]
		},
		"time_cap_s": {
			"type": "integer",
			"exclusiveMinimum": 0,
			"maximum": 9007199254740991
		},
		"score": {
			"type": "object",
			"properties": {
				"type": {
					"type": "string",
					"enum": [
						"time",
						"load_lb",
						"rounds_reps",
						"reps",
						"seconds",
						"points",
						"text",
						"checkbox"
					]
				},
				"better": {
					"anyOf": [
						{
							"type": "string",
							"enum": [
								"lower",
								"higher"
							]
						},
						{
							"type": "null"
						}
					]
				},
				"note": {
					"type": "string"
				}
			},
			"required": [
				"type",
				"better"
			],
			"additionalProperties": false
		},
		"equipment": {
			"type": "array",
			"items": {
				"type": "string"
			}
		},
		"home_ok": {
			"type": "boolean"
		},
		"home_note": {
			"type": "string"
		},
		"favorite": {
			"type": "boolean"
		},
		"recurrence": {
			"type": "string"
		},
		"reference": {
			"type": "string"
		},
		"definition_status": {
			"type": "string"
		},
		"energy_tags_sheet": {
			"type": "array",
			"items": {
				"type": "string"
			}
		},
		"sources": {
			"type": "array",
			"items": {
				"type": "string"
			}
		},
		"tags": {
			"type": "object",
			"properties": {
				"movements": {
					"type": "array",
					"items": {
						"type": "string",
						"enum": [
							"thruster",
							"wall_ball",
							"overhead_squat",
							"front_squat",
							"back_squat",
							"air_squat",
							"pistol",
							"squat_snatch",
							"db_snatch",
							"power_snatch",
							"squat_clean",
							"power_clean",
							"clean_and_jerk",
							"jerk",
							"push_press",
							"shoulder_press",
							"bench_press",
							"deadlift",
							"sdhp",
							"kb_swing",
							"devils_press",
							"turkish_getup",
							"bear_complex",
							"lunge",
							"box_jump",
							"burpee",
							"pull_up",
							"chest_to_bar",
							"muscle_up",
							"ring_row",
							"weighted_row",
							"rope_climb",
							"hspu",
							"push_up",
							"dip",
							"handstand_walk",
							"toes_to_bar",
							"knees_to_elbow",
							"sit_up",
							"l_sit",
							"plank",
							"v_up",
							"double_under",
							"run",
							"row",
							"bike",
							"ski",
							"farmers_carry",
							"sled",
							"sandbag"
						]
					}
				},
				"patterns": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"modality": {
					"type": "string",
					"pattern": "^M?G?W?$"
				},
				"home_ok_auto": {
					"type": [
						"boolean",
						"null"
					]
				},
				"tag_source": {
					"type": "string",
					"enum": [
						"auto",
						"hand"
					]
				}
			},
			"required": [
				"movements",
				"patterns",
				"modality",
				"home_ok_auto",
				"tag_source"
			],
			"additionalProperties": false
		}
	},
	"required": [
		"id",
		"name",
		"kind",
		"score",
		"sources",
		"tags"
	],
	"additionalProperties": false
}
