{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"erasableSyntaxOnly": true,
		"types": ["$app/types", "node"]
	},
	"include": ["src", "lint", "scripts", "e2e", "vite.config.ts", "drizzle.config.ts", "eslint.config.js", "playwright.config.ts"],
	"exclude": ["src/service-worker"]
}
