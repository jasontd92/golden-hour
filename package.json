{
	"name": "golden-hour",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.21.0",
	"engines": {
		"node": "26.x"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "pnpm typecheck && pnpm lint && pnpm policy && pnpm test:unit",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p src/service-worker",
		"lint": "eslint . --max-warnings 0",
		"policy": "node scripts/check-md.ts && node scripts/check-features.ts && node scripts/plan-check.ts",
		"test:unit": "vitest --run",
		"test:e2e": "playwright test",
		"e2e:local": "node scripts/e2e-local.ts",
		"sessions:score": "node scripts/score-sessions.ts",
		"schema:emit": "node scripts/schema-emit.ts",
		"plan:check": "node scripts/plan-check.ts",
		"plan:generate": "node scripts/plan-generate.ts",
		"data:build": "node scripts/data-build.ts",
		"db:generate": "drizzle-kit generate",
		"proof:sync": "node scripts/sync-mutants.ts",
		"mutate": "stryker run",
		"ledger": "node scripts/ledger.ts",
		"oracle": "ROLE=oracle claude -p --agent oracle --permission-mode acceptEdits --allowedTools \"Bash(git *) Bash(pnpm *) Bash(node *) Bash(gh *)\" --output-format json"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@stryker-mutator/core": "10.1.1",
		"@stryker-mutator/vitest-runner": "10.1.1",
		"@sveltejs/adapter-vercel": "^7.0.3",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
		"ajv": "^8.20.0",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.15.0",
		"eslint-plugin-svelte": "^3.24.1",
		"fake-indexeddb": "^6.2.8",
		"fast-check": "^4.10.2",
		"globals": "^17.14.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-eslint-parser": "^1.10.1",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"yaml": "^2.9.1"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@libsql/client": "^0.18.0",
		"drizzle-orm": "^0.45.4",
		"idb": "^8.0.4",
		"uuid": "^14.0.3",
		"zod": "^4.6.7"
	}
}
